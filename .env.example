# Locale, con npm run dev.
PORT=3000
SITE_URL=http://localhost:3000

# In produzione SITE_URL è l'origine pubblica. nginx-proxy legge VIRTUAL_HOST.
# SITE_URL=https://example.com
# VIRTUAL_HOST=example.com
# LETSENCRYPT_HOST=example.com
# LETSENCRYPT_EMAIL=tu@esempio.com

# EPUB da leggere. In locale è ./works.
# Sul server può essere un percorso assoluto: gli script lo montano nel container.
WORKS_DIR=works
